# Frontend environment — copy to frontend/.env
# NEVER commit real secrets.

# Required: backend API origin (no trailing slash)
REACT_APP_BACKEND_URL=http://localhost:8000

# Optional: show Stripe/billing UI (keep false until Stripe is integrated)
REACT_APP_BILLING_ENABLED=false

# Optional: show "Explore demo workspace" on Login (must match backend ENABLE_DEMO_LOGIN)
REACT_APP_ENABLE_DEMO_LOGIN=false

# Optional build-time beta badge fallback (runtime BETA_MODE from /api/config/public wins)
REACT_APP_BETA_MODE=true

# Assistify OS / Operations Hub — environment template (root)
# Copy values into backend/.env and frontend/.env (see those files for details).
# NEVER commit real secrets.

# --- Shared ---
ENVIRONMENT=development
# production | development | test

# --- Backend (required) ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=assistify
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# --- Backend (production-required / recommended) ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# In production: set explicit origins (no *) and a strong JWT_SECRET (>=32 chars).

# --- Backend (optional safety / demo) ---
ENABLE_DEMO_SEED=false
# Set true ONLY for local/demo environments. Never enable in production.
DEMO_EMAIL=jordan@assistify.io
DEMO_PASSWORD=change-me-demo-password

# Team invitations
INVITATION_EXPIRY_DAYS=7

# Cookie overrides (optional; auto-derived from ENVIRONMENT + FRONTEND_URL)
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# --- AI provider ---
AI_PROVIDER=openai
# openai | emergent
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key
# EMERGENT_LLM_KEY=your-emergent-key   # required when AI_PROVIDER=emergent

# --- File storage ---
STORAGE_PROVIDER=local
# local | emergent
UPLOAD_DIR=./backend/uploads
# EMERGENT_LLM_KEY also required when STORAGE_PROVIDER=emergent

# --- Email ---
# Transactional (verify/reset/invite) uses EMAIL_PROVIDER when configured.
# Outbound product mail additionally requires EMAIL_SENDING_ENABLED=true.
EMAIL_PROVIDER=console
# console | resend
EMAIL_SENDING_ENABLED=false
EMAIL_DAILY_LIMIT=100
FROM_NAME=Assistify OS
# RESEND_API_KEY=re_xxx
# FROM_EMAIL=onboarding@assistify.dev
# REPLY_TO_EMAIL=
# RESEND_WEBHOOK_SECRET=whsec_xxx

# --- Integrations (Sprint 15) + Shared Inbox (Sprint 16) ---
# Fernet key (url-safe base64 32-byte) or any secret (derived). Falls back to JWT_SECRET.
# INTEGRATION_ENCRYPTION_KEY=
# Google OAuth — scopes include gmail.readonly (inbox sync) + gmail.send + calendar + tasks.
# After adding gmail.readonly, reconnect the Google integration so consent is re-granted.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/callback/google
# Microsoft OAuth — scopes include Mail.Read (inbox sync) + Mail.Send + Calendars.ReadWrite.
# After adding Mail.Read, reconnect the Microsoft integration so consent is re-granted.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# MICROSOFT_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/callback/microsoft
# Optional cron: cd backend && python -m inbox.sync_all
# Native inbox replies send via Gmail/Graph (requires gmail.send / Mail.Send). Standalone mail still uses EMAIL_PROVIDER.
# Slack OAuth (optional — Incoming Webhook URL also supported)
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/callback/slack

# --- Ops / deployment (Sprint 18) ---
# REDIS_URL=redis://localhost:6379/0
# WORKER_ENABLED=false
# SCHEDULER_ENABLED=false
# REQUIRE_REDIS=false
# LOG_LEVEL=INFO
# JSON_LOGS=false
# TRUSTED_HOSTS=
# APP_URL=http://localhost:3000
# API_URL=http://localhost:8000
# RELEASE_VERSION=dev
# SENTRY_DSN=
# INBOX_SYNC_INTERVAL_MINUTES=15
# INTEGRATION_HEALTH_INTERVAL_MINUTES=60
# EMAIL_RECONCILIATION_INTERVAL_MINUTES=10

# --- Frontend ---
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_BILLING_ENABLED=false

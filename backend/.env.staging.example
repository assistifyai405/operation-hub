# Staging environment template — copy to a private secret store.
# Do NOT commit real credentials.

ENVIRONMENT=staging
# Note: unknown ENVIRONMENT values are treated as production (fail-fast).

MONGO_URL=mongodb+srv://USER:PASS@CLUSTER/assistify_staging?retryWrites=true&w=majority
DB_NAME=assistify_staging

JWT_SECRET=replace-with-32plus-char-random-secret!!
INTEGRATION_ENCRYPTION_KEY=replace-with-fernet-key-urlsafe-32bytes=

# Public HTTPS origins (no localhost, no *)
FRONTEND_URL=https://staging.example.com
APP_URL=https://staging.example.com
API_URL=https://api.staging.example.com
CORS_ORIGINS=https://staging.example.com

# Cookies: staging HTTPS SPA on separate API host → Secure + SameSite=None
# (defaults apply when FRONTEND_URL is https://)
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

REDIS_URL=redis://:PASSWORD@redis-host:6379/0
REQUIRE_REDIS=true
WORKER_ENABLED=true
SCHEDULER_ENABLED=true

# AI
AI_PROVIDER=openai
OPENAI_API_KEY=sk-replace-me
# EMERGENT_LLM_KEY=

# Email (optional until go-live)
EMAIL_PROVIDER=resend
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
FROM_EMAIL=staging@yourdomain.com
FROM_NAME=Assistify OS Staging
REPLY_TO_EMAIL=
RESEND_WEBHOOK_SECRET=

# OAuth integrations (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.staging.example.com/api/integrations/oauth/callback/google
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://api.staging.example.com/api/integrations/oauth/callback/microsoft
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://api.staging.example.com/api/integrations/oauth/callback/slack

# Hard-off for staging launch
ENABLE_DEMO_LOGIN=false
ENABLE_DEMO_SEED=false
ALLOW_DEMO_IN_PRODUCTION=false

STORAGE_PROVIDER=local
UPLOAD_DIR=/data/uploads
TRUSTED_HOSTS=api.staging.example.com,staging.example.com
RELEASE_VERSION=staging
LOG_LEVEL=INFO
JSON_LOGS=true
# SENTRY_DSN=

# Optional alert delivery (Slack incoming webhook or generic HTTPS webhook)
ALERT_DELIVERY_ENABLED=false
ALERT_WEBHOOK_URL=
# ALERT_DEDUPE_SECONDS=900

# Frontend build (bake at image build time — not runtime)
# REACT_APP_BACKEND_URL=https://api.staging.example.com
# REACT_APP_BILLING_ENABLED=false
# REACT_APP_ENABLE_DEMO_LOGIN=false

# Backend environment — copy to backend/.env
# NEVER commit real secrets.

ENVIRONMENT=development

# Required
MONGO_URL=mongodb://localhost:27017
DB_NAME=assistify
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Recommended
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Demo seed (opt-in). Production stays off unless explicitly set true.
ENABLE_DEMO_SEED=false
DEMO_EMAIL=jordan@assistify.io
DEMO_PASSWORD=change-me-demo-password

# Team invitations (Sprint 13)
INVITATION_EXPIRY_DAYS=7
# Invitation emails use Resend when RESEND_API_KEY is set; otherwise the API
# returns invitationLink in development only (never in production).

# Cookies (optional overrides)
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# AI — use OpenAI directly (recommended for local)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key
# Or Emergent fallback:
# AI_PROVIDER=emergent
# AI_MODEL=gpt-5.4
# EMERGENT_LLM_KEY=your-emergent-key

# Storage — local filesystem for development
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# Or Emergent object storage:
# STORAGE_PROVIDER=emergent
# EMERGENT_LLM_KEY=your-emergent-key

# Email (optional)
# RESEND_API_KEY=
# FROM_EMAIL=onboarding@resend.dev

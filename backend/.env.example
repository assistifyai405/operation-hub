# Backend environment — copy to backend/.env
# NEVER commit real secrets.

ENVIRONMENT=development

# Required
MONGO_URL=mongodb://localhost:27017
DB_NAME=assistify
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Recommended
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Demo tooling (opt-in). Production stays off unless explicitly set true.
ENABLE_DEMO_SEED=false
ENABLE_DEMO_LOGIN=false
# ALLOW_DEMO_IN_PRODUCTION=false
DEMO_EMAIL=jordan@assistify.io
# Never ship a weak default in production with ENABLE_DEMO_SEED=true
DEMO_PASSWORD=change-me-demo-password

# Closed beta (Sprint 28)
BETA_MODE=true
AI_DAILY_REQUEST_LIMIT=200

# Legal placeholders (fill after KVK — do not invent values)
# LEGAL_COMPANY_NAME=
# LEGAL_TRADE_NAME=
# LEGAL_CONTACT_EMAIL=
# LEGAL_PRIVACY_EMAIL=
# LEGAL_ADDRESS=
# LEGAL_KVK_NUMBER=
# LEGAL_VAT_NUMBER=

# Production also requires INTEGRATION_ENCRYPTION_KEY and a real AI provider key.
# See docs/PRODUCTION_ENV.md and backend/.env.production.example.

# Team invitations (Sprint 13)
INVITATION_EXPIRY_DAYS=7
# Invitation emails use Resend when RESEND_API_KEY is set; otherwise the API
# returns invitationLink in development only (never in production).

# Cookies (optional overrides)
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# AI — use OpenAI directly (recommended for local)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key
# Or Emergent fallback:
# AI_PROVIDER=emergent
# AI_MODEL=gpt-5.4
# EMERGENT_LLM_KEY=your-emergent-key

# Storage — local filesystem for development
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
# Or Emergent object storage:
# STORAGE_PROVIDER=emergent
# EMERGENT_LLM_KEY=your-emergent-key

# Email (optional)
# RESEND_API_KEY=
# FROM_EMAIL=onboarding@resend.dev

# Outbound email (Sprint 14) — sending is OFF by default
EMAIL_PROVIDER=console
# console | resend
EMAIL_SENDING_ENABLED=false
FROM_NAME=Assistify
# REPLY_TO_EMAIL=
EMAIL_DAILY_LIMIT=100
# RESEND_WEBHOOK_SECRET=whsec_xxx   # for POST /api/webhooks/resend

# Integrations Hub (Sprint 15) + Shared Inbox (Sprint 16)
# INTEGRATION_ENCRYPTION_KEY=
# Google: gmail.readonly + gmail.send + calendar + tasks (reconnect after scope changes)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/callback/google
# Microsoft: Mail.Read + Mail.Send + Calendars.ReadWrite (reconnect after scope changes)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# MICROSOFT_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/callback/microsoft
# Optional scheduled sync: python -m inbox.sync_all [--org ID] [--mailbox ID] [--force-full]
# Inbox-linked replies use native Gmail/Graph send (gmail.send / Mail.Send). Standalone uses EMAIL_PROVIDER.
# Ops (Sprint 18)
# REDIS_URL=redis://localhost:6379/0
# WORKER_ENABLED=false
# SCHEDULER_ENABLED=false
# REQUIRE_REDIS=false
# LOG_LEVEL=INFO
# JSON_LOGS=false
# RELEASE_VERSION=dev
# SENTRY_DSN=
# INBOX_SYNC_INTERVAL_MINUTES=15
# INTEGRATION_HEALTH_INTERVAL_MINUTES=60
# EMAIL_RECONCILIATION_INTERVAL_MINUTES=10
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/callback/slack

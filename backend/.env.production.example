# Production backend environment template
# Copy to a private secret store / .env — NEVER commit real values.
# See docs/PRODUCTION_ENV.md for REQUIRED vs OPTIONAL.

ENVIRONMENT=production

# --- Required ---
MONGO_URL=mongodb+srv://USER:PASS@cluster/assistify?retryWrites=true&w=majority
DB_NAME=assistify
JWT_SECRET=replace-with-openssl-rand-hex-32-or-longer
CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
APP_URL=https://app.example.com
API_URL=https://api.example.com

REDIS_URL=redis://:PASSWORD@redis-host:6379/0
REQUIRE_REDIS=true
WORKER_ENABLED=true
SCHEDULER_ENABLED=true

INTEGRATION_ENCRYPTION_KEY=replace-with-fernet-or-long-random-secret

AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-live-replace-me

# --- Demo / billing (keep off) ---
ENABLE_DEMO_LOGIN=false
ENABLE_DEMO_SEED=false
ALLOW_DEMO_IN_PRODUCTION=false

# --- Email (optional day-1) ---
EMAIL_PROVIDER=resend
EMAIL_SENDING_ENABLED=false
RESEND_API_KEY=
FROM_EMAIL=noreply@example.com
FROM_NAME=Assistify

# --- Storage ---
STORAGE_PROVIDER=local
UPLOAD_DIR=/app/uploads

# --- Ops ---
LOG_LEVEL=INFO
JSON_LOGS=true
RELEASE_VERSION=1.0.0
# TRUSTED_HOSTS=api.example.com,localhost
# SENTRY_DSN=
